APP_ENV=development
LOG_LEVEL=INFO

# LLM (Groq) — optional for degraded/rule-based mode if unset
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL_SYNTHESIS=qwen/qwen3.8-27b
GROQ_MODEL_ROUTING=qwen/qwen3.8-27b

# Neo4j — Docker Compose (recommended): set NEO4J_PASSWORD only; compose uses bolt://neo4j:7687
# Local Python dev against Compose Neo4j: NEO4J_URI=bolt://localhost:7687
# Aura (optional): neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# FastAPI source (cloned by indexer or mounted in compose)
FASTAPI_REPO_PATH=./data/repos/fastapi

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_API_KEY=

# MCP agent URLs (local dev defaults; compose overrides)
MCP_ORCHESTRATOR_URL=http://127.0.0.1:9001/mcp
MCP_INDEXER_URL=http://127.0.0.1:9002/mcp
MCP_GRAPH_QUERY_URL=http://127.0.0.1:9003/mcp
MCP_CODE_ANALYST_URL=http://127.0.0.1:9004/mcp
MCP_MEMORY_URL=http://127.0.0.1:9005/mcp

# Memory (SQLite path for session store)
MEMORY_DB_PATH=./data/memory/sessions.db
